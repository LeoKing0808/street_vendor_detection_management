FROM maven:3.8.5-openjdk-17 AS build
WORKDIR /app
# 先复制pom.xml文件，利用Docker缓存
COPY pom.xml .
# 使用国内镜像源加速Maven依赖下载
RUN mvn dependency:go-offline -Dmaven.repo.local=/root/.m2/repository -Dmaven.wagon.http.ssl.insecure=true -Dmaven.wagon.http.ssl.allowall=true -Dmaven.wagon.http.ssl.ignore.validity.dates=true
# 复制源代码
COPY src ./src
# 构建项目
RUN mvn package -DskipTests -Dmaven.repo.local=/root/.m2/repository -Dmaven.wagon.http.retryHandler.count=5 -Dmaven.wagon.http.retryHandler.minuteTimeout=30 -Dmaven.wagon.httpconnectionManager.ttlSeconds=120 -Dmaven.wagon.httpconnectionManager.maxTotal=50 -Dmaven.wagon.http.retryHandler.maximumRetriesPerRequest=3 -Dmaven.wagon.http.retryHandler.requestSentRetryEnabled=true -Dmaven.wagon.http.retryHandler.retryableModes=CONNECTION_FAILURE,READ_TIMEOUT,SOCKET_TIMEOUT,UNDEFINED_SERVER_ERROR -Dmaven.wagon.http.retryHandler.retryInterval=5000 -Dmaven.wagon.http.retryHandler.backoffMultiplier=1.5 -Dmaven.wagon.http.retryHandler.maxInterval=30000 -Dmaven.wagon.http.retryHandler.randomizationFactor=0.25 -Dmaven.wagon.http.retryHandler.maxAttempts=10 -Dmaven.wagon.http.retryHandler.requestSentRetryEnabled=true -Dmaven.wagon.http.retryHandler.retryableModes=CONNECTION_FAILURE,READ_TIMEOUT,SOCKET_TIMEOUT,UNDEFINED_SERVER_ERROR -Dmaven.wagon.http.retryHandler.retryInterval=5000 -Dmaven.wagon.http.retryHandler.backoffMultiplier=1.5 -Dmaven.wagon.http.retryHandler.maxInterval=30000 -Dmaven.wagon.http.retryHandler.randomizationFactor=0.25 -Dmaven.wagon.http.retryHandler.maxAttempts=10 -Dmaven.repo.local=/root/.m2/repository -Dmaven.wagon.http.ssl.insecure=true -Dmaven.wagon.http.ssl.allowall=true -Dmaven.wagon.http.ssl.ignore.validity.dates=true -Dmaven.compiler.verbose=true -Dmaven.test.skip=true -Dmaven.javadoc.skip=true -Dcheckstyle.skip=true -Dpmd.skip=true -Dfindbugs.skip=true -Djacoco.skip=true -Dcobertura.skip=true -Dsonar.skip=true -Dmaven.deploy.skip=true -Dmaven.install.skip=true -Dmaven.site.skip=true -Dmaven.source.skip=true -Dmaven.javadoc.skip=true -Dmaven.test.skip=true -DskipTests -Dmaven.repo.local=/root/.m2/repository -Dmaven.wagon.http.retryHandler.count=5 -Dmaven.wagon.http.retryHandler.minuteTimeout=30 -Dmaven.wagon.httpconnectionManager.ttlSeconds=120 -Dmaven.wagon.httpconnectionManager.maxTotal=50 -Dmaven.wagon.http.retryHandler.maximumRetriesPerRequest=3 -Dmaven.wagon.http.retryHandler.requestSentRetryEnabled=true -Dmaven.wagon.http.retryHandler.retryableModes=CONNECTION_FAILURE,READ_TIMEOUT,SOCKET_TIMEOUT,UNDEFINED_SERVER_ERROR -Dmaven.wagon.http.retryHandler.retryInterval=5000 -Dmaven.wagon.http.retryHandler.backoffMultiplier=1.5 -Dmaven.wagon.http.retryHandler.maxInterval=30000 -Dmaven.wagon.http.retryHandler.randomizationFactor=0.25 -Dmaven.wagon.http.retryHandler.maxAttempts=10 -Dmaven.wagon.http.retryHandler.requestSentRetryEnabled=true -Dmaven.wagon.http.retryHandler.retryableModes=CONNECTION_FAILURE,READ_TIMEOUT,SOCKET_TIMEOUT,UNDEFINED_SERVER_ERROR -Dmaven.wagon.http.retryHandler.retryInterval=5000 -Dmaven.wagon.http.retryHandler.backoffMultiplier=1.5 -Dmaven.wagon.http.retryHandler.maxInterval=30000 -Dmaven.wagon.http.retryHandler.randomizationFactor=0.25 -Dmaven.wagon.http.retryHandler.maxAttempts=10 -Dmaven.repo.local=/root/.m2/repository -Dmaven.wagon.http.ssl.insecure=true -Dmaven.wagon.http.ssl.allowall=true -Dmaven.wagon.http.ssl.ignore.validity.dates=true -Dmaven.compiler.verbose=true -Dmaven.test.skip=true -Dmaven.javadoc.skip=true -Dcheckstyle.skip=true -Dpmd.skip=true -Dfindbugs.skip=true -Djacoco.skip=true -Dcobertura.skip=true -Dsonar.skip=true -Dmaven.deploy.skip=true -Dmaven.install.skip=true -Dmaven.site.skip=true -Dmaven.source.skip=true -Dmaven.javadoc.skip=true -Dmaven.test.skip=true -DskipTests -Dmaven.repo.local=/root/.m2/repository

FROM eclipse-temurin:17-jre
WORKDIR /app
COPY --from=build /app/target/*.jar app.jar
EXPOSE 8080
CMD ["java", "-jar", "app.jar"]
